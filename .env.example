# Application
APP_NAME=Expense Sharing & Wallet Service
APP_ENV=development
DEBUG=true

# PostgreSQL (Docker Compose & SQLAlchemy)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expense_db
POSTGRES_TEST_DB=expense_test_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/expense_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/expense_test_db
SQL_ECHO=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (NFR-11: Access 15-30p, Refresh 7 ngày)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7